# Cluster profile. Copy to scripts/cluster.env (or point FP4AR_CLUSTER_ENV at a copy) and edit; never commit job IDs.
# Selected by CLUSTER=<name>. Variables:
#   LOGIN     ssh target of the login node (sync.sh, check_compile.sh --remote)
#   JOB       an EXISTING Slurm job id; every step is `srun --jobid=$JOB --overlap` (these scripts never allocate)
#   IMG       container image (.sqsh) for pyxis; MOUNTS = --container-mounts value
#   WORK      cluster-side work root: src/ build/ runs/ logs/ locks/ clock/ home/
#   ARCH      nvcc arch suffix (100a GB200/GB300, 107a VR200); NVCC = compiler inside the image
#   NCCL_HOME dir with include/ and lib/ (NCCL >= 2.31 with nccl_device); NCCL_LIBDIR overrides lib/
#   MEMCLK_LOCK / MEMCLK_DEFAULT  HBM MHz for clk.sh lock/reset verification (empty LOCK = no locking, no guard)
#   NGPU      GPUs per node (clock readback compares all of them)
CLUSTER=${CLUSTER:-vr200}
case $CLUSTER in
  vr200)    # VR200 NVL, 4 GPUs/node
    LOGIN=user@login.vr200.example.com; JOB=000000
    IMG=/path/to/containers/vllm-arm64-cuda13.5.sqsh; MOUNTS=/path/to/shared:/path/to/shared
    WORK=/path/to/shared/campaigns/fp4-allreduce
    ARCH=${ARCH:-107a}; NVCC=${NVCC:-/usr/local/cuda-13.5/bin/nvcc}
    NCCL_HOME=/usr; NCCL_LIBDIR=/usr/lib/aarch64-linux-gnu
    MEMCLK_LOCK=4752; MEMCLK_DEFAULT=3186; NGPU=4 ;;
  gb200)    # GB200 NVL72, 4 GPUs/node; NCCL 2.31.2 unpacked from the pip wheel onto shared storage
    LOGIN=user@login.gb200.example.com; JOB=000000
    IMG=/path/to/containers/vllm-arm64-cuda13.0.sqsh; MOUNTS=/path/to/shared:/path/to/shared
    WORK=/path/to/shared/campaigns/fp4-allreduce-gb200
    ARCH=${ARCH:-100a}; NVCC=${NVCC:-/usr/local/cuda/bin/nvcc}
    NCCL_HOME=$WORK/nccl231/nvidia/nccl; NCCL_LIBDIR=
    MEMCLK_LOCK=; MEMCLK_DEFAULT=3996; NGPU=4 ;;
  *) echo "unknown CLUSTER=$CLUSTER (edit cluster.env)" >&2; return 2 2>/dev/null || exit 2 ;;
esac
